- const entry = typeof home === 'undefined' ? enervate_home() : home
- const welcome = 'Welcome to my blog'
- const nav = [{ label: '首页', href: '#top' }, { label: '文章', href: '#writing' }, ...entry.sections.map(section => ({ label: section.title, href: '#' + section.id }))]
- const categoryLabels = { Life: '生活', Notes: '笔记', Programming: '编程' }
- const termsFor = field => [...new Map(entry.posts.flatMap(post => post[field]).map(term => [term.name, term])).values()]
- const categories = termsFor('categories')
- const tags = termsFor('tags')
doctype html
html(lang='zh-CN')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    meta(name='description' content='Enervate. 记录生活、阅读与科研。')
    meta(name='theme-color' content='#faf9f7')
    if entry.canonical
      link(rel='canonical' href=entry.canonical)
    title Enervate.
    link(rel='icon' href=entry.asset + 'icon.png' type='image/png')
    link(rel='preload' href=entry.asset + 'instrument-serif.woff2' as='font' type='font/woff2' crossorigin)
    link(rel='stylesheet' href=entry.asset + 'widgets.css')
    link(rel='stylesheet' href=entry.asset + 'home.css')
  body
    a.skip(href='#writing') 跳到文章
    header.masthead
      .nav-shell
        nav.nav-fallback(aria-label='主导航')
          each item, index in nav
            a(href=item.href aria-current=index === 0 ? 'location' : undefined)= item.label
        div(data-nav-mount)
    main
      section.hero#top(aria-labelledby='home-title')
        a.wordmark.hero-wordmark(href='#top' aria-label='Enervate. 首页') Enervate.
        h1.visually-hidden#home-title(lang='en')= welcome
        .cloth-stage(data-cloth data-title=welcome)
          .cloth-still(aria-hidden='true')
            picture
              source(media='(max-width: 800px) and (orientation: portrait)' srcset=entry.asset + 'cloth-mobile.webp')
              img(src=entry.asset + 'cloth-desktop.webp' alt='' fetchpriority='high')
          canvas(aria-hidden='true')
          .cloth-input(aria-hidden='true')
        a.index-link(href='#writing') 浏览文章
      section.writing#writing(aria-labelledby='writing-title')
        .section-head
          h2#writing-title 文章
          .writing-actions
            button.wall-toggle(type='button' data-wall-toggle aria-controls='article-wall' hidden) 列表视图
            a.quiet-link(href=entry.links.archives) 文章归档
        if entry.posts.length
          nav.article-filters(aria-label='文章筛选' data-article-filters)
            a.filter-chip(href='#writing' data-filter='all' aria-current='true') 全部
            each term in categories
              a.filter-chip(href=term.href data-filter='category' data-value=term.name)= categoryLabels[term.name] || term.name
            if tags.length
              details.tag-filter
                summary.filter-chip
                  span(data-tag-filter-label) 标签
                ul.tag-filter-options
                  each term in tags
                    li
                      a(href=term.href data-filter='tag' data-value=term.name)= term.name
            p.visually-hidden(data-filter-status role='status')
          .article-wall#article-wall(data-article-wall)
            div(data-wall-mount aria-hidden='true')
            ul.posts
              each post, index in entry.posts
                - const category = post.categories.map(({ name }) => categoryLabels[name] || name).join(' · ')
                li(data-category=JSON.stringify(post.categories.map(term => term.name)) data-tag=JSON.stringify(post.tags.map(term => term.name)))
                  a.post-card(href=post.href class=post.image ? 'post-card--cover' : '' data-tone=index % 5)
                    if post.image
                      img.post-cover(src=post.image alt='' loading='lazy' decoding='async')
                    .post-meta
                      if category
                        span.post-category= category
                      time.post-date(datetime=post.date)= post.date.replace(/-/g, '.')
                    span.post-title= post.title
        else
          p.empty 暂无文章
      if entry.sections.length
        .profile-sections
          each section in entry.sections
            section.profile-section(id=section.id aria-labelledby=section.id + '-title')
              h2(id=section.id + '-title')= section.title
              .profile-copy
                != section.content
                if section.id === 'about'
                  nav.profile-contact(aria-label='联系方式')
                    a(href='mailto:xu_jinyao@outlook.com') xu_jinyao@outlook.com
                    a(href='https://github.com/XuJinyao0301') GitHub
    footer.colophon
      a.wordmark(href='#top') Enervate.
      nav(aria-label='更多入口')
        if entry.sections.some(section => section.id === 'about')
          a(href='#about') 联系方式
    script(type='module' src=entry.asset + 'cloth.js')
    script(type='module' src=entry.asset + 'widgets.js')
